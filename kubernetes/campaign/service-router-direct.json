{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "labels": {
      "purpose": "v3-transport-dev001"
    },
    "name": "router-direct",
    "namespace": "rolloutsecbench"
  },
  "spec": {
    "externalTrafficPolicy": "Cluster",
    "ports": [
      {
        "nodePort": 30800,
        "port": 8000,
        "protocol": "TCP",
        "targetPort": 8000
      }
    ],
    "selector": {
      "app": "router"
    },
    "type": "NodePort"
  }
}
