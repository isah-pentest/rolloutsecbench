{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "labels": {
      "app.kubernetes.io/component": "model-service",
      "app.kubernetes.io/name": "rolloutsecbench",
      "rolloutsecbench/revision": "v2"
    },
    "name": "model-v2",
    "namespace": "rolloutsecbench"
  },
  "spec": {
    "ports": [
      {
        "name": "http",
        "port": 8000,
        "protocol": "TCP",
        "targetPort": "http"
      }
    ],
    "selector": {
      "app": "model-v2"
    },
    "type": "ClusterIP"
  }
}
